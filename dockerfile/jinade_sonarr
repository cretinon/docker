ARG VERSION="1.1"
ARG DISTRIB
ARG DOCKERSRC
ARG BASE_TAG

FROM ${DOCKERSRC}:${DISTRIB}
ARG DISTRIB
ARG DOCKERSRC
ARG TARGETPLATFORM
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY

RUN if [ "$DISTRIB" = "debian" ]; then apt-get update && apt-get -y -q install --no-install-recommends netbase autofs nfs-common net-tools libsqlite3-0 wget ca-certificates && apt-get clean && rm -rf /var/cache/apt/* /var/lib/apt/lists/* ; fi
RUN if [ "$DISTRIB" = "alpine" ]; then apk add --no-cache --purge autofs nfs-utils sqlite-libs wget ca-certificates && rm -rf /var/cache/apk/* ; fi

ENV HTTP_PROXY=
ENV HTTPS_PROXY=

RUN mkdir -p /opt/Sonarr

COPY --chmod=755 entrypoint/sonarr.sh /usr/local/bin/

WORKDIR /opt/Sonarr

RUN if [ "$TARGETPLATFORM" = "linux/amd64" ]; then wget -O- "https://github.com/Sonarr/Sonarr/releases/download/v4.0.13.2932/Sonarr.main.4.0.13.2932.linux-x64.tar.gz" | tar xz --strip-components=1 && rm -rfv Sonarr.Update ; fi
RUN if [ "$TARGETPLATFORM" = "linux/arm64" ]; then wget -O- "https://github.com/Sonarr/Sonarr/releases/download/v4.0.13.2932/Sonarr.main.4.0.13.2932.linux-arm64.tar.gz" | tar xz --strip-components=1 && rm -rfv Sonarr.Update ; fi
RUN if [ "$TARGETPLATFORM" = "linux/arm/v7" ]; then wget -O- "https://github.com/Sonarr/Sonarr/releases/download/v4.0.13.2932/Sonarr.main.4.0.13.2932.linux-arm.tar.gz" | tar xz --strip-components=1 && rm -rfv Sonarr.Update ; fi

EXPOSE 8989

ENTRYPOINT ["/usr/local/bin/sonarr.sh"]
