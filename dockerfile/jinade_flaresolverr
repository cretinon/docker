ARG VERSION="1.1"
ARG DISTRIB
ARG DOCKERSRC
ARG BASE_TAG

FROM ${DOCKERSRC}:${DISTRIB}
ARG DISTRIB
ARG DOCKERSRC
ARG TARGETPLATFORM
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY

# debian only: the stacks of the fleet consume the `_debian` images (see _build_all)
RUN apt-get update && apt-get -y -q install --no-install-recommends iproute2 netbase net-tools chromium xvfb python-is-python3 wget ca-certificates && apt-get clean && rm -rf /var/cache/apt/* /var/lib/apt/lists/*

# Clear proxy variables for final image
ENV HTTP_PROXY=
ENV HTTPS_PROXY=

COPY --chmod=755 entrypoint/flaresolverr.sh /usr/local/bin/

# fetch.sh, the build-time downloader: it goes through the apt cache of the lab when
# HTTP_PROXY points at it (see entrypoint/fetch.sh). A `wget` called directly here fetches
# from the builder, where the cache is not reachable, and it used to hand an empty body (the
# file type the cache refuses) to `tar` without a word
COPY --chmod=755 entrypoint/fetch.sh /usr/local/bin/

WORKDIR /opt

# the release is amd64 only, and it is downloaded to /tmp before being unpacked, so a failed
# or empty download fails the build instead of unpacking nothing
RUN if [ "$TARGETPLATFORM" = "linux/amd64" ]; then HTTP_PROXY="$HTTP_PROXY" fetch.sh "https://github.com/FlareSolverr/FlareSolverr/releases/download/v3.3.21/flaresolverr_linux_x64.tar.gz" > /tmp/flaresolverr.tar.gz && tar xzf /tmp/flaresolverr.tar.gz && rm -f /tmp/flaresolverr.tar.gz ; fi

WORKDIR /opt/flaresolverr
RUN if [ "$TARGETPLATFORM" = "linux/amd64" ]; then chmod +x /opt/flaresolverr/flaresolverr ; fi

EXPOSE 8191

ENTRYPOINT ["/usr/local/bin/flaresolverr.sh"]
