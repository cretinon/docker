ARG VERSION="1.1"
ARG DISTRIB
ARG DOCKERSRC
ARG BASE_TAG

FROM ${DOCKERSRC}:${DISTRIB}
ARG DISTRIB
ARG DOCKERSRC
ARG TARGETPLATFORM
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY

RUN if [ "$DISTRIB" = "debian" ]; then apt-get update && apt-get -y -q install --no-install-recommends openvpn iptables curl ca-certificates net-tools procps lsof iproute2 && apt-get clean && rm -rf /var/cache/apt/* /var/lib/apt/lists/* ; fi
RUN if [ "$DISTRIB" = "alpine" ]; then apk add --no-cache --purge openvpn iptables curl ca-certificates net-tools procps lsof iproute2 ; fi

# Clear proxy variables for final image
ENV HTTP_PROXY=
ENV HTTPS_PROXY=

RUN if [ "$DISTRIB" = "debian" ]; then groupadd vpn ; fi
RUN if [ "$DISTRIB" = "alpine" ]; then addgroup vpn ; fi

RUN mkdir /vpn

ADD http://www.privateinternetaccess.com/openvpn/ca.crt /vpn/

COPY entrypoint/openvpn.sh /usr/bin/

ENTRYPOINT ["openvpn.sh"]
