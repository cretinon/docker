ARG VERSION="1.1"
ARG DISTRIB
ARG DOCKERSRC
ARG BASE_TAG

FROM ${DOCKERSRC}:${DISTRIB}
ARG DISTRIB
ARG DOCKERSRC
ARG TARGETPLATFORM
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ARG UNRAR_VERSION=6.2.6

RUN if [ "$DISTRIB" = "debian" ]; then echo "deb http://deb.debian.org/debian trixie main contrib non-free" >> /etc/apt/sources.list && echo " deb http://deb.debian.org/debian trixie-backports main contrib non-free" >> /etc/apt/sources.list ; fi
RUN if [ "$DISTRIB" = "debian" ]; then apt-get update && apt-get -y -q install --no-install-recommends unrar sabnzbdplus netbase autofs procps nfs-common net-tools gir1.2-xapp-1.0 libavahi-compat-libdnssd1 python3-dbus python3-notify2 pip curl ca-certificates && apt-get clean && rm -rf /var/cache/apt/* /var/lib/apt/lists/* ; fi

ENV HTTP_PROXY=
ENV HTTPS_PROXY=

ADD entrypoint/sabnzbd.sh /usr/local/sabnzbd.sh
RUN chmod 755 /usr/local/sabnzbd.sh

RUN mkdir -p /etc/auto.master.d/
RUN echo "/mnt/nfs        /sabnzbd/auto.syno --ghost,--timeout=60" > /etc/auto.master.d/syno.autofs

EXPOSE 8080/tcp

ENTRYPOINT ["/usr/local/sabnzbd.sh"]
