ARG ARCH
ARG DISTRIB
ARG DOCKERSRC

ARG HTTP_PROXY
ARG HTTPS_PROXY

FROM ${ARCH}${DOCKERSRC}:${DISTRIB}
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY

RUN apt-get update && apt-get -y -q install --no-install-recommends openvpn iptables curl ca-certificates net-tools procps lsof iproute2 && apt-get clean && rm -rf /var/cache/apt/* /var/lib/apt/lists/*

# Clear proxy variables for final image
ENV HTTP_PROXY=
ENV HTTPS_PROXY=

RUN groupadd vpn
RUN mkdir /vpn

ADD http://www.privateinternetaccess.com/openvpn/ca.crt /vpn/

COPY entrypoint/openvpn.sh /usr/bin/

ENTRYPOINT ["openvpn.sh"]
